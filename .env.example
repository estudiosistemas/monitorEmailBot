NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Base de datos SQLite (en local suele ser file:./data/mail-agent.db y en Render file:/data/mail-agent.db)
DATABASE_URL="file:./data/mail-agent.db"

# Clave de cifrado de 32 bytes en formato hex (64 caracteres) para tokens y contraseñas
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Microsoft OAuth
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3000/auth/microsoft/callback

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Telegram
TELEGRAM_BOT_TOKEN=

# Seguridad y sesiones
SESSION_SECRET=un_secreto_muy_seguro_de_al_menos_32_caracteres

# Configuración del Poller
POLL_INTERVAL_MINUTES=5
ENABLE_EMBEDDED_POLLER=true
